---
import DiscoveryExplorer from '../components/DiscoveryExplorer'
import { developmentDiscoveryItems } from '../data/discovery.fixture'
import { parseDiscoveryQuery } from '../lib/discovery-query'
import PublicLayout from '../layouts/PublicLayout.astro'

const initialState = parseDiscoveryQuery(Astro.url.searchParams)
---

<PublicLayout title="Discovery — Drops">
  <main class="public-main">
    <section class="catalog-intro">
      <span class="development-badge">Development fixture</span>
      <h1>Discovery</h1>
      <p>Un catalogo editoriale per esplorare musica, scene e relazioni.</p>
    </section>
    <DiscoveryExplorer items={developmentDiscoveryItems} initialState={initialState} client:load />
  </main>
</PublicLayout>
