# API container. Generate hash as documented; never store plaintext password here.
DROPS_WEB_USERNAME=replace-with-staging-username
DROPS_WEB_PASSWORD_HASH=replace-with-generated-argon2id-hash
DROPS_WEB_ALLOWED_ORIGINS=https://drops.giancarlocesarei.workers.dev
DROPS_WEB_COOKIE_SECURE=true
DROPS_WEB_ENV=production
DROPS_WEB_STATE_DIR=/data
DROPS_WEB_ARTIFACT_TTL_SECONDS=600
DROPS_WEB_MAX_QUEUED=20
DROPS_WEB_MAX_CONCURRENT=2
DROPS_WEB_MAX_DURATION_SECONDS=900
DROPS_WEB_MAX_FILE_BYTES=100000000
# Spotify OAuth. Values reali solo nei secret Render.
SPOTIFY_CLIENT_ID=replace-with-spotify-client-id
SPOTIFY_REDIRECT_URI=https://drops.giancarlocesarei.workers.dev/api/v1/spotify/callback
SPOTIFY_REFRESH_TOKEN=replace-after-first-connect
DISCOGS_TOKEN=replace-with-discogs-personal-token
DISCOGS_USER_AGENT=Drops/1.0 +https://drops.giancarlocesarei.workers.dev
# Opzionale; default: data/catalog nel repository.
DROPS_CATALOG_DIR=/app/data/catalog
PORT=8000

# Astro static build. Must equal public API origin, without trailing slash.
PUBLIC_API_URL=https://drops.giancarlocesarei.workers.dev
